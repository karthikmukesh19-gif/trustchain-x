# Copy to backend/.env for running the backend outside Docker.
# Never commit a real .env file.

APP_ENV=development

# Required in production (at least 32 characters). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# In development, leaving it empty makes the backend generate a random secret
# at start-up (tokens then stop working whenever the backend restarts).
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=trustchain_x
REDIS_URL=redis://localhost:6379/0

# Comma-separated list of browser origins allowed to call the API. '*' is rejected.
CORS_ORIGINS=http://localhost:5173

# Authentication attempts allowed per client address per window.
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60

# Optional. A GitHub token raises the API rate limit from 60 to 5000 requests/hour.
# Use a fine-grained token with read-only access to public repositories.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT_SECONDS=8

WORKER_HEARTBEAT_SECONDS=10

# Repository analysis limits (defaults shown).
ANALYSIS_MAX_REPO_KB=2097152
ANALYSIS_MAX_FILES=25000
ANALYSIS_MAX_MANIFESTS=300
ANALYSIS_MAX_MANIFEST_BYTES=8388608
ANALYSIS_MAX_TOTAL_BYTES=67108864
ANALYSIS_MAX_DEPENDENCIES=30000
ANALYSIS_TIMEOUT_SECONDS=300
ANALYSIS_STALE_JOB_SECONDS=900
