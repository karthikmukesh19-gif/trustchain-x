# Copy to .env (same folder as docker-compose.yml). Never commit .env.
# `docker compose up --build` also works without a .env file, in development mode.

# development | production. Production refuses to start without a JWT_SECRET
# of at least 32 characters and disables the interactive API docs.
APP_ENV=development

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Optional GitHub token (read-only, public repositories) to raise API rate limits.
GITHUB_TOKEN=

# Optional MongoDB authentication. Set all three together; the URI must carry
# the same credentials, for example:
#   MONGO_ROOT_USERNAME=trustchain
#   MONGO_ROOT_PASSWORD=<long random password>
#   MONGODB_URI=mongodb://trustchain:<password>@mongodb:27017/?authSource=admin
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
MONGODB_URI=mongodb://mongodb:27017

# Host ports.
FRONTEND_PORT=5173
BACKEND_PORT=8000

# Optional analysis limits (defaults shown). A repository beyond a limit is
# refused with a clear error rather than partly analysed.
# ANALYSIS_MAX_REPO_KB=2097152
# ANALYSIS_MAX_FILES=25000
# ANALYSIS_MAX_MANIFESTS=300
# ANALYSIS_MAX_MANIFEST_BYTES=8388608
# ANALYSIS_TIMEOUT_SECONDS=300
