# Copy to .env (same folder as docker-compose.yml). Never commit .env.
# `docker compose up --build` also works without a .env file, in development mode.

# development | production. Production refuses to start without a JWT_SECRET
# of at least 32 characters and disables the interactive API docs.
APP_ENV=development

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Optional GitHub token (read-only, public repositories) to raise API rate limits.
GITHUB_TOKEN=

# Optional MongoDB authentication. Set all three together; the URI must carry
# the same credentials, for example:
#   MONGO_ROOT_USERNAME=trustchain
#   MONGO_ROOT_PASSWORD=<long random password>
#   MONGODB_URI=mongodb://trustchain:<password>@mongodb:27017/?authSource=admin
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
MONGODB_URI=mongodb://mongodb:27017

# Host ports.
FRONTEND_PORT=5173
BACKEND_PORT=8000

# Optional analysis limits (defaults shown). A repository beyond a limit is
# refused with a clear error rather than partly analysed.
# ANALYSIS_MAX_REPO_KB=2097152
# ANALYSIS_MAX_FILES=25000
# ANALYSIS_MAX_MANIFESTS=300
# ANALYSIS_MAX_MANIFEST_BYTES=8388608
# ANALYSIS_TIMEOUT_SECONDS=300

# Vulnerability intelligence (Phase 3). Defaults shown.
# The provider URL is fixed by configuration and must be https on a host listed
# in VULNERABILITY_ALLOWED_HOSTS. An invalid value stops the backend from
# starting. Only "osv" exists so far.
# VULNERABILITY_PROVIDERS=osv
# VULNERABILITY_ALLOWED_HOSTS=api.osv.dev
# OSV_API_URL=https://api.osv.dev
# VULNERABILITY_TIMEOUT_SECONDS=15
# VULNERABILITY_MAX_RECORDS=5000
# VULNERABILITY_SYNC_TIMEOUT_SECONDS=600
# JOB_RATE_LIMIT=30

# Code reachability (Phase 4). Defaults shown. One GitHub request is made per
# Python source file, so set GITHUB_TOKEN above for anything but small repositories.
# REACHABILITY_MAX_FILES=2000
# REACHABILITY_MAX_FILE_BYTES=524288
# REACHABILITY_TIMEOUT_SECONDS=600
# Path (inside the worker container) of an operator-maintained JSON file that
# names the functions an advisory affects. See docs/phase4.md. Empty: none.
# REACHABILITY_SYMBOL_MAPPINGS_FILE=

# Dependency intelligence (Phase 5). Defaults shown.
# Release metadata (latest version, release dates) is read from the public
# package registries. Each URL is fixed here, must be https, and its host must
# be listed in PACKAGE_METADATA_ALLOWED_HOSTS; an invalid value stops the
# backend from starting. Only package names and nothing else is sent.
# To make no registry request at all, set PACKAGE_METADATA_PROVIDERS to an
# empty value: versions and release ages are then reported as unknown.
# PACKAGE_METADATA_PROVIDERS=pypi,npm
# PACKAGE_METADATA_ALLOWED_HOSTS=pypi.org,registry.npmjs.org
# PYPI_API_URL=https://pypi.org
# NPM_REGISTRY_URL=https://registry.npmjs.org
# PACKAGE_METADATA_TTL_HOURS=24
# PACKAGE_METADATA_MAX_PACKAGES=2000
# INTELLIGENCE_MAX_NODES=5000
# INTELLIGENCE_MAX_EDGES=50000
# INTELLIGENCE_TIMEOUT_SECONDS=600
# INTELLIGENCE_HISTORY_LIMIT=50
